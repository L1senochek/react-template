{
  "name": "react-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint ./src --report-unused-disable-directives --max-warnings 0 --ext ts,tsx",
    "lint:fix": "npm run lint -- --fix",
    "preview": "vite preview",
    "format:fix": "prettier --write .",
    "prettier": "npx prettier ./src --check",
    "prettier:fix": "npm run prettier -- --write",
    "coverage": "vitest run --coverage.enabled --coverage.all",
    "stylelint": "npx stylelint \"**/*.{css,scss}\" --fix",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "test": "vitest",
    "deploy": "bash setup-deploy.sh",
    "new-repo-install": "bash ./setup-install.sh",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "npm run lint:fix",
      "npm run prettier:fix"
    ],
    "**/*.{css,scss}": "stylelint --fix"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.8.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-compiler": "^19.0.0-beta-27714ef-20250124",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-exports": "^0.9.1",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "path": "^0.12.7",
    "path-type": "^6.0.0",
    "prettier": "3.4.2",
    "sass-embedded": "^1.83.4",
    "stylelint": "^16.25.0",
    "stylelint-color-format": "^1.1.0",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-prettier": "^0.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-stylelint": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
